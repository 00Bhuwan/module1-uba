FLASK_APP = app       # FLASK_APP = app Purpose: Tells the flask command where to find your application instance or factory.
FLASK_DEBUG = 1       # 1 or True
# FLASK_RUN_PORT: Specifies a custom port for the development serve e.g 8080
# FLASK_RUN_HOST: Sets the host address to bind the server to e.g 0.0.0.0

# loaded first before env but env overwrites if conflict occurs